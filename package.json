{
  "name": "mcp-support-evals",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript MCP server with a measurable eval suite for LLM tool use",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http-cli.js",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:replay": "node dist/eval/replay.js",
    "eval:live": "node --env-file=.env.local dist/eval/live.js",
    "report": "node --experimental-strip-types scripts/report.ts",
    "report:check": "npm run report -- --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
